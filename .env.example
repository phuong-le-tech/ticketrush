# Local dummy values only. Copy to .env and adjust. No real secrets here.
# Service ports: gateway 8080, inventory 8081, payment 8082, fake-provider 8083,
# order 8084, notification 8085.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POSTGRES_URL=jdbc:postgresql://localhost:5432/ticketrush
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=ticketrush-local
ORDER_DB_URL=jdbc:postgresql://localhost:5432/ticketrush
ORDER_DB_USER=ticketrush
ORDER_DB_PASSWORD=ticketrush-local
KAFKA_AUTO_OFFSET_RESET=earliest
GATEWAY_KAFKA_MAX_BLOCK_MS=3000
GATEWAY_KAFKA_REQUEST_TIMEOUT_MS=2000
GATEWAY_KAFKA_DELIVERY_TIMEOUT_MS=5000
GATEWAY_SEND_TIMEOUT_MS=6000
REDIS_HOST=localhost
REDIS_PORT=6379
PAYMENT_PROVIDER_URL=http://localhost:8083
PAYMENT_PROVIDER_TIMEOUT_MS=2000
INVENTORY_SEED_EVENT_ID=concert-1
INVENTORY_SEED_STOCK=1000
INVENTORY_SEED_PRICE_CENTS=5000
INVENTORY_SEED_CURRENCY=EUR
